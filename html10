<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ülesanne 10</title>
</head>
<body>
  <form action="#" method="post">
   <h1>ÕPILASE REGISTREERIMISVORM</h1>
   <h2>Isikuandmed</h2>
   <fieldset>
     <div class="mb-5 row">
        <label class="col-sm-2 col-form-label">Eesnimi</label>
        <div class="col-sm-10">
         <input type="text" placeholder="Nuur">
        </div>
     </div>
     <div class="mb-5 row">
        <label class="col-sm-2 col-form-label">Perekonnanimi</label>
        <div class="col-sm-10">
         <input type="text" placeholder="Seeger">
        </div>
     </div>
     <div class="mb-5 row">
        <label class="col-sm-2 col-form-label">Sünnikuupäev</label>
        <div class="col-sm-10">
         <input type="date" min="1960-01-01" max="2015-01-01">              
        </div>
      </div>
      <div class="mb-5 row"> 
         <label class="col-sm-2 col-form-label">Sugu</label>
         <div class="col-sm-10">
           <input type="radio" name="Sugu" value="Mees"> Mees
           <input type="radio" name="Sugu" value="Naine"> Naine
           <input type="radio" name="Sugu" value="Muu"> Vikerkaared
         </div>
      </div>
      </fieldset>

      <h2>Kontakt</h2>
      <fieldset>
       <div class="mb-5 row">
          <label class="col-sm-2 col-form-label">E-post</label>
          <div class="col-sm-10">
           <input type="text" placeholder="NuurSeeger@gmail.com">
          </div>
       </div>
       <div class="mb-5 row">
          <label class="col-sm-2 col-form-label">Mobiiltelefon</label>
          <div class="col-sm-10">
            <input type="tel" placeholder="+372">
          </div>
       </div>
       <div class="mb-5 row">
          <label class="col-sm-2 col-form-label">Aadress</label>
          <div class="col-sm-10">
            <textarea class="form-control" placeholder="Kraavi-Augu 4" rows="3"></textarea>
          </div>
       </div>
       <div class="mb-5 row">
         <label class="col-sm-2 col-form-label">Linn/Asula</label>
         <div class="col-sm-10">
           <input type="text" placeholder="Kambja">
         </div>
       </div>
       <div class="mb-5 row">
          <label class="col-sm-2 col-form-label">Postiindeks</label>
          <div class="col-sm-10">
            <input type="text" placeholder="nt 90535">
          </div>
       </div>
       <div class="mb-5 row">
          <label class="col-sm-2 col-form-label">Riik</label>
          <div class="col-sm-10">
            <input class="form-control" type="text" placeholder="Eesti" aria-label="Disabled input example" disabled>
          </div>
       </div>  
       </fieldset>

       <h2>Muu info</h2>
       <fieldset>
         <div class="mb-5 row"> 
            <label class="col-sm-2 col-form-label">Huvialad</label>
            <div class="col-sm-10">
             <input type="checkbox" name="Joonistamine"> Joonistamine
             <input type="checkbox" name="Laulmine"> Laulmine
             <input type="checkbox" name="Tantsimine"> Tantsimine
             <input type="checkbox" name="Kokkamine"> Kokkamine
             <input type="checkbox" name="Muu"> Muu(Kirjuta kasti)
             <div class="col-sm-10">
               <textarea class="form-control" placeholder="nt ping-pong" rows="2"></textarea>
             </div> 
           </div>
         </div>
         <div class="mb-5 row">
            <label class="col-sm-2 col-form-label">Isiklik veebileht</label>
            <div class="col-sm-10">
              <input type="url" placeholder="https:// või http://">
            </div>
         </div>
         <div class="mb-5 row">
            <label class="col-sm-2 col-form-label">Eelistatud teemavärv</label>
            <div class="col-sm-10">
             <input type="color" class="form-control form-control-color" value="#563d7c" title="Choose your color">
            </div>
         </div>
         <div class="mb-5 row">
           <label class="col-sm-2 col-form-label">Dokumendid</label>
           <div class="col-sm-10">
             <input class="form-control" type="file" accept=".jpg,.png,.pdf">
           </div>
         </div>
      </fieldset>

      <h2>Nõustumine</h2>
      <fieldset>
       <div class="mb-5 row"> 
         <div class="col-sm-10">
           <input type="checkbox"> Kinnitan, et esitatud andmed on õiged ja luban nende töötlemist vastavalt kooli tingimustele
         </div>
       </div>
     </fieldset>
     
     <button type="submit">Saada</button>
     <button type="reset">Tühjenda</button> 
  </form>
</body>

</html>
